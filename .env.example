PORT=3000
NODE_ENV=development

# Pendaftaran di halaman awal (false = hanya admin boleh tambah akun lewat dashboard)
PUBLIC_REGISTER=true

JWT_SECRET=ganti-dengan-string-random-panjang

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sikasir

# Proxy (di belakang Nginx): set 1
TRUST_PROXY=1

# CORS asal frontend (opsional, default: semua)
# CORS_ORIGIN=https://kasir.example.com

# Rate limit API (/api): max permintaan per menit per IP
RATE_LIMIT_MAX=100

# Setelah sekian pelanggaran (rate limit, brute, dll.) → blacklist permanen
BLACKLIST_VIOLATION_THRESHOLD=10

# Brute force login
LOGIN_MAX_FAIL=5
LOGIN_LOCK_MS=3600000

# Email alert saat login diblokir (opsional — tanpa ini log ke console)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_EMAIL=
 
 # Redis Configuration
 # REDIS_URL=redis://default:password@localhost:6379
